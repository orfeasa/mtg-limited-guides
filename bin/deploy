#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

ssh_target="${LIMITED_SSH_TARGET:-orfeas@birthday.orfeasa.com}"
app_root="${LIMITED_APP_ROOT:-/home/orfeas/apps/mtg-limited-guides}"
release="$(git rev-parse --short=12 HEAD)"

if [[ "$app_root" != /home/orfeas/apps/* || "$app_root" == "/home/orfeas/apps/" ]]; then
  echo "Refusing unsafe app root: $app_root" >&2
  exit 1
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Refusing to deploy an uncommitted working tree." >&2
  exit 1
fi

node scripts/build-data.mjs
node scripts/verify-data.mjs
node scripts/verify-observed-ratings.mjs
node scripts/verify-lifecycle.mjs
node scripts/verify-training-tolerance.mjs
node scripts/verify-prep.mjs
node scripts/verify-teaching.mjs
node scripts/verify-licensed-research.mjs
node scripts/verify-memory.mjs
node scripts/verify-service-worker.mjs
node scripts/verify-archetype-study.mjs

if ! git diff --quiet -- public/index.html public/data.js public/sw.js; then
  echo "Generated public data is stale. Commit the rebuilt files before deploying." >&2
  exit 1
fi

git archive --format=tar HEAD public |
  ssh "$ssh_target" "
    set -eu
    app_root='$app_root'
    release='$release'
    releases=\"\$app_root/releases\"
    release_dir=\"\$releases/\$release\"
    mkdir -p \"\$releases\"
    exec 9>\"\$app_root/deploy.lock\"
    flock -x 9
    test ! -e \"\$release_dir\" || {
      echo \"Release \$release is already present.\" >&2
      exit 1
    }
    incoming=\$(mktemp -d \"\$releases/.\$release.incoming.XXXXXX\")
    tar -xf - -C \"\$incoming\" --strip-components=1
    chmod 0755 \"\$incoming\"
    test -f \"\$incoming/index.html\"
    test -f \"\$incoming/app.js\"
    test -f \"\$incoming/data.js\"
    test -f \"\$incoming/sw.js\"
    mv \"\$incoming\" \"\$release_dir\"
    previous=\$(readlink -f \"\$app_root/current\" || true)
    ln -sfn \"\$release_dir\" \"\$app_root/current.next\"
    mv -Tf \"\$app_root/current.next\" \"\$app_root/current\"
    test \"\$(readlink -f \"\$app_root/current\")\" = \"\$release_dir\"
    verification=\$(mktemp -d)
    verified=true
    for asset in index.html app.js styles.css data.js sw.js; do
      if ! curl --fail --silent --show-error --connect-timeout 10 --max-time 60 \\
        \"https://limited.orfeasa.com/\$asset?release=\$release\" -o \"\$verification/\$asset\" || \\
        ! cmp -s \"\$release_dir/\$asset\" \"\$verification/\$asset\"; then
        verified=false
        break
      fi
    done
    rm -rf -- \"\$verification\"
    if [ \"\$verified\" != true ]; then
      if [ -n \"\$previous\" ] && [ -d \"\$previous\" ]; then
        ln -sfn \"\$previous\" \"\$app_root/current.next\"
        mv -Tf \"\$app_root/current.next\" \"\$app_root/current\"
      fi
      echo 'Live verification failed; releases preserved, previous target restored if available.' >&2
      exit 1
    fi
    find \"\$releases\" -regextype posix-extended -mindepth 1 -maxdepth 1 \\
      -type d -regex '.*/[0-9a-f]{12}' ! -name \"\$release\" -exec rm -rf -- {} +
  "

echo "Deployed $release to https://limited.orfeasa.com"
